<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="pwBgGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#F0B854"/>
      <stop offset="100%" stop-color="#A8721F"/>
    </linearGradient>
    <linearGradient id="pwChickGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F6E4C1"/>
    </linearGradient>
  </defs>

  <rect x="0" y="0" width="512" height="512" rx="112" ry="112" fill="url(#pwBgGrad)"/>
  <ellipse cx="200" cy="160" rx="180" ry="120" fill="#FFFFFF" opacity="0.10"/>

  <!-- Tail feather -->
  <path d="M 144 304 Q 88 264 112 208 Q 144 240 168 272 Z" fill="#5E2E22"/>

  <!-- Body -->
  <ellipse cx="256" cy="304" rx="128" ry="120" fill="url(#pwChickGrad)"/>

  <!-- Wing (subtle) -->
  <path d="M 216 320 Q 264 300 304 336 Q 264 372 216 352 Z"
        fill="#E8D4AA" opacity="0.75"/>

  <!-- Head -->
  <circle cx="304" cy="208" r="80" fill="url(#pwChickGrad)"/>

  <!-- Comb -->
  <path d="M 280 128 Q 296 106 316 116 Q 332 102 348 120 Q 338 142 316 138 Q 298 146 280 128 Z"
        fill="#C1502E"/>

  <!-- Beak -->
  <path d="M 368 208 L 408 220 L 368 236 Z" fill="#F0B854"/>

  <!-- Eye -->
  <circle cx="324" cy="196" r="10" fill="#2B2116"/>
  <circle cx="327" cy="193" r="3.2" fill="#FFFFFF" opacity="0.9"/>
</svg>